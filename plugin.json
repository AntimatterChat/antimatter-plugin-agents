{
  "id": "mattermost-ai",
  "name": "AI chat",
  "description": "The AI chat side panel: talk with the agents you may use, and ask them to summarise threads, channels and calls.",
  "homepage_url": "https://github.com/antimatterchat/antimatter-plugin-agents",
  "support_url": "https://github.com/antimatterchat/antimatter-plugin-agents/issues",
  "release_notes_url": "https://github.com/antimatterchat/antimatter-plugin-agents",
  "icon_path": "assets/icon.svg",
  "min_server_version": "12.0.0",
  "server": {
    "executables": {
      "linux-amd64": "server/dist/plugin-linux-amd64",
      "linux-arm64": "server/dist/plugin-linux-arm64",
      "darwin-amd64": "server/dist/plugin-darwin-amd64",
      "darwin-arm64": "server/dist/plugin-darwin-arm64",
      "windows-amd64": "server/dist/plugin-windows-amd64.exe"
    }
  },
  "webapp": {
    "bundle_path": "webapp/dist/main.js"
  },
  "settings_schema": {
    "header": "",
    "footer": "",
    "settings": [
      {
        "key": "Config",
        "type": "custom",
        "secret": true
      }
    ]
  },
  "props": {
    "antimatter_agents_in_server": true
  }
}
